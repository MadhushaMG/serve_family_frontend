{
  "expo": {
    "name": "Serve Family",
    "slug": "LocationTrackerApp",
    "version": "49.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo/icon.png",
    "splash": {
      "image": "./src/assets/logo/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "servefamily",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.servefamily.app",
      "buildNumber": "49",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Serve Family uses your location to show your real-time position on the map for safety tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Serve Family needs continuous location access to provide real-time family safety alerts and emergency SOS features, even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Serve Family monitors your location in the background to ensure your family can find you during emergencies and to trigger geofencing alerts.",
        "NSPhotoLibraryUsageDescription": "Allow Serve Family to access your photos to set and personalize your profile picture.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "654NGDWSA7"
    },
    "android": {
      "versionCode": 49,
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBoqhQWOBssPSZpeWLuVEiaqF0Qzu2oQqk"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/logo/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.servefamily.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "29.0.14033849"
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Serve Family to access your location always to track your safety and provide emergency SOS features.",
          "locationAlwaysPermission": "Allow Serve Family to access your location always to display it on the map even when the app is in the background.",
          "locationWhenInUsePermission": "Allow Serve Family to access your location to show it on the map.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Serve Family to access your photos to set and personalize your profile picture."
        }
      ],
      "expo-av",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.150224001782-nvkesb6r3p8tpvengoveen1g5ekjmj86"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f73dc46f-d8ea-4617-a8a8-920f51754bb6"
      }
    },
    "owner": "200220702825"
  }
}
