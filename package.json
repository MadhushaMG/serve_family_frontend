{
  "name": "bubbles-server",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsnd --respawn -r tsconfig-paths/register --pretty --transpile-only ./src/app.ts",
    "patch": "npm version patch --no-git-tag-version",
    "copy-env": "node -e \"const fs = require('fs'); fs.copyFileSync('.env', 'dist/.env');\"",
    "copy-docs": "node -e \"const fs = require('fs'); fs.mkdirSync('dist/docs', { recursive: true }); fs.cpSync('src/docs', 'dist/docs', { recursive: true });\"",
    "build": "tsc && tsc-alias && npm run copy-env && npm run copy-docs",
    "build:render": "npm run build && node scripts/build-render.js",
    "migrate": "sequelize-cli db:migrate --config sequelize.config.cjs --migrations-path src/db/migrations"
  },
  "dependencies": {
    "@turf/distance": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mapbox-gl": "^3.24.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^4.6.3",
    "uuid": "^13.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.7",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.15.6",
    "@types/yup": "^0.29.14",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
